{
  "entities": {
    "Suggestion": {
      "title": "Suggestion",
      "description": "A suggestion or inquiry posted to the Seodaejeon High School real-name suggestion board",
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "maxLength": 100,
          "description": "Title of the suggestion"
        },
        "content": {
          "type": "string",
          "maxLength": 2000,
          "description": "Detailed body content of the suggestion"
        },
        "authorName": {
          "type": "string",
          "maxLength": 20,
          "description": "Real name of the author student/staff"
        },
        "grade": {
          "type": "number",
          "description": "Grade (1-3) or 0 for staff"
        },
        "classNum": {
          "type": "number",
          "description": "Class number (1-10) or 0 for staff"
        },
        "category": {
          "type": "string",
          "enum": ["급식", "시설/환경", "학사/수업", "학생자치/동아리", "기타"],
          "description": "Category of the suggestion"
        },
        "status": {
          "type": "string",
          "enum": ["접수대기", "검토중", "답변완료"],
          "description": "Current resolution status"
        },
        "likeCount": {
          "type": "number",
          "description": "Number of agreed students/votes"
        },
        "reply": {
          "type": "string",
          "maxLength": 1000,
          "description": "Official reply from student council or school staff"
        },
        "replyAuthor": {
          "type": "string",
          "maxLength": 50,
          "description": "Department or person replying"
        },
        "replyAt": {
          "type": "string",
          "description": "Date of reply"
        },
        "passwordHash": {
          "type": "string",
          "maxLength": 64,
          "description": "4-digit pin or password for editing/deleting"
        },
        "createdAt": {
          "type": "string",
          "description": "ISO timestamp of creation"
        }
      },
      "required": ["title", "content", "authorName", "category", "createdAt"]
    }
  },
  "firestore": {
    "/suggestions/{suggestionId}": {
      "schema": "Suggestion",
      "description": "Collection of real-name suggestions for Seodaejeon High School"
    }
  }
}
